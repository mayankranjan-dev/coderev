#!/bin/sh
# Pre-push guard: blocks pushes to main/master, deletions, non-fast-forward
# pushes, secret leaks, and failing tests. Do not bypass or edit without the owner.

ZERO="0000000000000000000000000000000000000000"

fail() {
    echo "pre-push BLOCKED: $1" >&2
    exit 1
}

# Resolve gitleaks (Git's sh may not share the shell PATH).
GITLEAKS="$(command -v gitleaks)"
[ -z "$GITLEAKS" ] && GITLEAKS="$(command -v gitleaks.exe)"
if [ -z "$GITLEAKS" ] && [ -n "$LOCALAPPDATA" ]; then
    GITLEAKS="$(find "$LOCALAPPDATA/Microsoft/WinGet/Packages" -name gitleaks.exe 2>/dev/null | head -n 1)"
fi
[ -z "$GITLEAKS" ] && fail "gitleaks not found (checked PATH and WinGet packages)."

is_zero() {
    case "$1" in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue

    case "$remote_ref" in
        refs/heads/main | refs/heads/master)
            fail "pushing to $remote_ref is not allowed. Merge via pull request." ;;
    esac

    is_zero "$local_sha" && fail "deleting remote ref $remote_ref is not allowed."

    if ! is_zero "$remote_sha"; then
        git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null ||
            fail "non-fast-forward or force push to $remote_ref is not allowed."
    fi
done

# Secret scan.
if "$GITLEAKS" git --help >/dev/null 2>&1; then
    "$GITLEAKS" git --no-banner || fail "gitleaks found leaks."
else
    "$GITLEAKS" detect --no-banner || fail "gitleaks found leaks."
fi

# Test gate.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || fail "cannot enter repo root."
PY=python
[ -x ".venv/Scripts/python.exe" ] && PY=".venv/Scripts/python.exe"
[ -x ".venv/bin/python" ] && PY=".venv/bin/python"

if [ -d tests ]; then
    "$PY" -m pytest -q || fail "pytest failed."
else
    FILES="$(git ls-files '*.py')"
    [ -z "$FILES" ] || echo "$FILES" | tr '\n' '\0' | xargs -0 "$PY" -m compileall -q || fail "compileall failed."
fi

exit 0
