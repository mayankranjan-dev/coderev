WEBHOOK_SECRET=changeme
# Required X-API-Key value for /api/reviews, /api/reviews/manual and
# /api/execute. Left empty, those endpoints refuse every request (403).
CODEREV_API_KEY=

# Per-IP request limits per window. 0 disables a limit.
RATE_LIMIT_EXECUTE_PER_MINUTE=10
RATE_LIMIT_REVIEW_PER_MINUTE=5
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated cross-origin callers. Same-origin use needs no entry.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Built frontend served at "/". Defaults to frontend/dist next to main.py.
FRONTEND_DIST_DIR=frontend/dist
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=10
# Context window sent on every request (tokens). Always explicit so large
# diffs are not truncated by a smaller version-dependent default.
OLLAMA_NUM_CTX=8192
# whole | per_file
REVIEW_CHUNKING=whole
# Extra attempts after blank or unparseable model output (bounded; 0 = off).
REVIEW_MAX_RETRIES=1
# prompts/<version>.txt used for production reviews (v1 or v2).
REVIEW_PROMPT_VERSION=v1
DATABASE_URL=sqlite:///./audit.db

# Code execution sandbox (Judge0 Community Edition).
# The public CE instance needs no API key. wait=true makes the call synchronous
# and base64_encoded=false sends source as plain UTF-8, so keep both query
# params if you point this at a self-hosted or RapidAPI-fronted Judge0.
JUDGE0_API_URL=https://ce.judge0.com/submissions?base64_encoded=false&wait=true
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_TIMEOUT_SECONDS=30
MAX_EXECUTE_CODE_CHARS=50000

# Size limits for review input. A manual submission over MAX_REVIEW_CODE_CHARS
# gets HTTP 413. A fetched PR diff over MAX_DIFF_BYTES gets status diff_too_large.
MAX_REVIEW_CODE_CHARS=100000
MAX_DIFF_BYTES=2000000

# GET /api/reviews pagination: default page size and the largest allowed limit.
REVIEWS_DEFAULT_LIMIT=50
REVIEWS_MAX_LIMIT=200

# Retry queue for offline / timed-out / errored reviews (retry_queue.py).
RETRY_WORKER_ENABLED=1
RETRY_POLL_SECONDS=30
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=60
RETRY_BACKOFF_MAX_SECONDS=3600
